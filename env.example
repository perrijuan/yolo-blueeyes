# Copy to .env (gitignored) or export in the shell before train/infer.
#   cp env.example .env
#   source env.sh
#
# Workspace that contains datasets/ and weights/
# FUSAO_ROOT=/path/to/workspace
#
# DATASETS_ROOT=$FUSAO_ROOT/datasets
# WEIGHTS_DIR=$FUSAO_ROOT/weights
# YOLOOW_ROOT=./finetune_yoloow/YoloOW
#
# SeaDronesSee
# SDS_15GB=$DATASETS_ROOT/seadronessee_15gb
# SDS_4GB=$DATASETS_ROOT/seadronessee_reduzido_4gb
# SDS_COCO=$DATASETS_ROOT/SeaDronesSee_MOT/annotations
#
# MVTD (GOT-10k tree + YOLO export + checkpoints)
# MVTD_ROOT=$FUSAO_ROOT/mvtd
# MVTD_RAW=$MVTD_ROOT/Maritime_Visual_Tracking_Dataset_MVTD
# MVTD_YOLO=$MVTD_ROOT/yolo
# MVTD_PESOS=$MVTD_ROOT/pesos
#
# COCO init for YOLOv8s
# COCO_INIT=$FUSAO_ROOT/yolov8s.pt
#
# PYTHON=/path/to/.venv/bin/python
# YOLO_GIT_OUT=./runs
